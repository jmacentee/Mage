@page "/inprogress"
@inject GameService GameService
@inject NavigationManager Nav
@inject LocalStorageService Storage


@if (game is not null)
{
    <header class="sticky">
        <h3>@* Game In Progress -  *@Round @roundNumber (of @MaxRounds(game.Players.Count))  <span class="@GetRoundTypeClass()"><span class="RoundTypeCount">@TricksDifference</span></span></h3>
        <p><b>Dealer:</b> @dealerName</p>
        <p><b>First Player:</b> @firstPlayerName</p>
    </header>



    <div class="bid-cards">
        @{
            int PlayerIndex = 0;
        }
        @foreach (var player in game.Players)
        {

            <div class="@GetRoundTitleClass(PlayerIndex)">
                <b><span class="player-name">@player.Name</span> (@player.Score pts) @GetRoundTitle(PlayerIndex)</b><br />
                                <input type="number" min="0" max="@roundNumber" @bind="GetBid(player.Name).BidValue" placeholder="Bid" 
                @bind:event="oninput"
                                @onchange="() => OnBidValueChanged(player.Name)"
                onfocus="this.select();" />

                                <button class="@GetButtonClass(player.Name, true)" @onclick="() => SetSuccess(player.Name)">😊</button>
                                <button class="@GetButtonClass(player.Name, false)" @onclick="() => SetFail(player.Name)">☹️</button>

                                @if (failSelected.GetValueOrDefault(player.Name))
                {
                                    <input type="number" min="0" max="@roundNumber" placeholder="Took" @bind="GetBid(player.Name).TricksTaken" @bind:event="oninput" onfocus="this.select();" />
                }
            </div>
            PlayerIndex++;
        }
    </div>
    <footer class="sticky">
        <button @onclick="Undo">⟲</button>
        <button @onclick="ViewScoresheet">🧮</button>
        <button @onclick="ToHome">🏠</button>
        @if (!IsFinalRound)

        {

            <button @onclick="NextRound" disabled="@( !GameIsFinal() )" class="primary">Next Round</button>

        }else{
            <button @onclick="CompleteGame" disabled="@( !GameIsFinal() )" class="primary">Game Over</button>
        }
        <span class="@ShowTricks()">Tricks: @TotalTricksTaken</span>  
    </footer>
}else{

    <header class="sticky">
        <h3>No Game In Progress</h3>

    </header>

    <footer class="sticky">
        <button @onclick="ToHome">🏠</button>

    </footer>
}

@code {
    Game? game;
    Round? currentRound;
    int roundNumber { get; set; } = 1;
    string dealerName = "";
    string firstPlayerName = "";

    Dictionary<string, bool> successSelected = new();
    Dictionary<string, bool> failSelected = new();

    private string ShowTricks(){
        if (TotalTricksTaken > 0) return "";
        return "hidden";
    }

    private int? TotalTricksTaken => game?.Players.Sum(player =>
    {
            var bid = GetBid(player.Name);
        if (bid == null) return 0;
        if (bid.Success == null) return 0;
        if (!bid.TricksTaken.HasValue == null) return 0;

        return bid.TricksTaken;
    });

    private int? TotalTricksBid => game?.Players.Sum(player =>
    {
            var bid = GetBid(player.Name);
        if (bid == null) return 0;
        return bid.BidValue;
    });


    protected string GetRoundTypeClass(){
        if (TotalTricksBid == 0) return "RoundType hidden";
        if (TotalTricksBid == roundNumber) return "RoundType CoOp";
        if (TotalTricksBid > roundNumber) return "RoundType Taking";
        if (TotalTricksBid < roundNumber) return "RoundType Ducking";
        return "";
    }

    private int? TricksDifference => Math.Abs(roundNumber - TotalTricksBid.GetValueOrDefault());

    protected override void OnInitialized()
    {
        game = GameService.CurrentGame;

        StartRound();

    }

    protected string GetRoundTitle(int PlayerIndex)
    {
        if (PlayerIndex == currentRound.DealerIndex) return " Dealer!";
        if (PlayerIndex == currentRound.FirstPlayerIndex) return " First!";
        return "";
    }

    protected string GetRoundTitleClass(int PlayerIndex)
    {
        if (PlayerIndex == currentRound.DealerIndex) return "dealer bid-card";
        if (PlayerIndex == currentRound.FirstPlayerIndex) return "first bid-card";
        return "bid-card";
    }

    private void StartRound(){
        currentRound = game?.Rounds.LastOrDefault();

        if (game != null && currentRound != null)
        {
            roundNumber = currentRound.RoundNumber;
            dealerName = game.Players[currentRound.DealerIndex].Name;
            firstPlayerName = game.Players[currentRound.FirstPlayerIndex].Name;
        }

    }

    Bid GetBid(string name)
    {
        if (currentRound == null) return new Bid();
            var bid = currentRound.Bids.FirstOrDefault(b => b.PlayerName == name);
        if (bid == null)
        {
                bid = new Bid { PlayerName = name };
            currentRound.Bids.Add(bid);
        }
        return bid;
    }

        void SetSuccess(string name)
    {
            successSelected[name] = true;
            failSelected[name] = false;
            Bid bid = GetBid(name);
        bid.Success = true;
        bid.TricksTaken = bid.BidValue;
    }

        void SetFail(string name)
    {
            failSelected[name] = true;
            successSelected[name] = false;
            Bid bid = GetBid(name);
        bid.Success = false;
        bid.TricksTaken = null;
    }

        private void OnBidValueChanged(string name)
    {
            var bid = GetBid(name);
            failSelected[name] = false;
            successSelected[name] = false;
        bid.Success = null;
        bid.TricksTaken = null;
    }

        string GetButtonClass(string name, bool isSuccess)
    {
            bool selected = isSuccess ? successSelected.GetValueOrDefault(name) : failSelected.GetValueOrDefault(name);
        if (isSuccess){
            return selected ? "selectedSuccess" : "ToggleSuccess";
        }else{
            return selected ? "selectedFail" : "ToggleSuccess";
        }
    }

    void Undo()
    {
        successSelected.Clear();
        failSelected.Clear();
        foreach (var bid in currentRound.Bids)
        {
            bid.TricksTaken = null;
            bid.Success = null;
        }
    }


    void NextRound()
    {
        ApplyScores();
        var nextRoundNum = roundNumber + 1;
        var nextDealer = (currentRound!.DealerIndex + 1) % game!.Players.Count;
        var nextFirst = (nextDealer + 1) % game.Players.Count;
        game.Rounds.Add(new Round { RoundNumber = nextRoundNum, DealerIndex = nextDealer, FirstPlayerIndex = nextFirst });
        GameService.SaveGame();
        successSelected.Clear();
        failSelected.Clear();

        StartRound();
        //Nav.NavigateTo("./inprogress", forceLoad: true);
    }

    void CompleteGame()
    {
        ApplyScores();
        game!.IsComplete = true;
        GameService.SaveGame();
        Nav.NavigateTo("./gameover");
    }

    void ApplyScores()
    {
        foreach (var bid in currentRound!.Bids)
        {
            var player = game!.Players.First(p => p.Name == bid.PlayerName);

            if (bid.Success == true)
                player.Score += bid.BidValue + 2;
            else if (bid.TricksTaken.HasValue)
                player.Score -= Math.Abs(bid.BidValue - bid.TricksTaken.Value);


            bid.RoundPoints = player.Score;
        }
    }

    void ToHome(){
        GameService.SaveGame();
        Nav.NavigateTo("./");
    }

    void ViewScoresheet(){
        GameService.SaveGame();
        Nav.NavigateTo("./scoresheet");
    }

    bool AllPlayersSubmitted =>
        game?.Players.All(p => successSelected.ContainsKey(p.Name) || failSelected.ContainsKey(p.Name)) ?? false;

    bool IsFinalRound =>
        game != null && game.Rounds.Count >= MaxRounds(game.Players.Count);


    bool GameIsFinal()
    {
        if (game == null) return false;
        if (currentRound == null) return false;
        if (!AllPlayersSubmitted) return false;

        // Ensure all bid values are within allowed range
        if (!game.Players.All(p =>
                    GetBid(p.Name).BidValue >= 0 &&
                    GetBid(p.Name).BidValue <= roundNumber))
            return false;

        // Ensure PointsLost values are valid for players who failed
        // if (!game.Players.All(p =>
                //     GetBid(p.Name).Success != false || // If Success is not false, ignore check
                //     (GetBid(p.Name).PointsLost >= 1 && GetBid(p.Name).PointsLost <= roundNumber)))
        //     return false;

        // Ensure all TricksTaken are within allowed range
        if (!game.Players.All(p =>
                    GetBid(p.Name).TricksTaken >= 0 &&
                    GetBid(p.Name).TricksTaken <= roundNumber))
            return false;

                if (game.Players.Any(p => GetBid(p.Name).Success==false && GetBid(p.Name).TricksTaken == GetBid(p.Name).BidValue))
            return false;

        if (TotalTricksTaken != roundNumber) return false;

        return true; // If all conditions are met, game is final


    }

    int MaxRounds(int count) => count switch
    {
        3 => 20,
        4 => 15,
        5 => 12,
        6 => 10,
        _ => 10
    };
}