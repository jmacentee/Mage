@page "/"
@inject GameService GameService
@inject NavigationManager Nav

<h1>Mage 🧙‍♂️</h1>
<h2>A Scorekeeping app for Wizard</h2>


@if(GameService.Initialized){
    @if (GameService.Games.Count == 0)
    {
        <p>No games yet.</p>
    }
    else
    {
        
        <ul>
            @foreach (var game in GameService.Games)
            {
                var dealerIndex = game.Rounds.FirstOrDefault()?.DealerIndex; // Get the dealer index from the first round
                <li @onclick="() => NavigateToGame(game)" class="@GetListClass(game)">
                    <b>@game.StartDate.ToShortDateString()</b>
                    - Players: @string.Join(", ", game.Players.Select((p, index) => index == dealerIndex ? $"{p.Initials}*" : p.Initials))
                    - @(game.IsComplete ? "Complete" : $"(Round {game.Rounds.Count})")
                </li>
            }
        </ul>
    }
}else{
    <p>loading...</p>
}

<footer class="sticky">
    
        <button @onclick="ClearHistory">Clear History</button>
    <button @onclick="NewGame" class="primary">New Game</button>
    
</footer>

@code {
    string GetListClass(Game game){
        if(game.IsComplete){
            return "GameIsComplete";
        }else{
            return "GameNotComplete";
        }
    }

    void ClearHistory()
    {
        GameService.Games.Clear();
        StateHasChanged();
    }

    void NewGame() => Nav.NavigateTo("./newgame");

    void NavigateToGame(Game game)
    {
        GameService.ResumeGame(game.Id);
        Nav.NavigateTo(game.IsComplete ? $"./scoresheet" : "./inprogress");
    }

    protected override void OnInitialized()
    {
        GameService.OnInitializedChanged += HandleInitializedChanged;
    }

    private void HandleInitializedChanged()
    {
        StateHasChanged(); // Force UI update
    }

    public void Dispose()
    {
        GameService.OnInitializedChanged -= HandleInitializedChanged;
    }


}