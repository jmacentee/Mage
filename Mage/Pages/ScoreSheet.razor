@page "/scoresheet"
@inject GameService GameService
@inject NavigationManager Nav

<h3>Score Sheet</h3>
@if (GameService.CurrentGame is null)
{
    <p>No active game.</p>
    <footer class="sticky">
        <button @onclick=@(() => Nav.NavigateTo("./"))>🏠</button>
    </footer>
}
else
{
    <p>Bid | Tricks Taken | End of Round Score</p>
    var game = GameService.CurrentGame;
    <table class="scoresheet striped">
        <thead>
            <tr>
                <th>Round</th>
                @foreach (var p in game.Players)
                {
                    <th>@p.Name</th>
                }
            </tr>
        </thead>
        <tbody>
            @for (int r = 0; r < game.Rounds.Count; r++)
            {
                <tr>
                    <td data-label="Round">@(r + 1)</td>
                    @foreach (var p in game.Players)
                    {
                        var bid = game.Rounds[r].Bids.FirstOrDefault(b => b.PlayerName == p.Name);
                        <td data-label="@bid?.PlayerName">
                            @(bid?.Success.HasValue == true ? (bid?.Success == true ? $"😊" : $"☹️") : $"")
                            @bid?.BidValue | @bid?.TricksTaken | @bid?.RoundPoints
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>

    <footer class="sticky">
        <button @onclick=@(() => Nav.NavigateTo("./"))>🏠</button>
        @if (!game.IsComplete)
        {
            <button @onclick=@(() => Nav.NavigateTo("./inprogress")) class="primary">Resume</button>
            
        }
        
    </footer>
       
    

}
